<h1>Tic Tac Toe</h1>

<p><strong>Current Turn:</strong> <%= @game.current_turn %></p>

<% if @game.status == "finished" %>
  <h2>🏆 Winner: <%= @game.winner %></h2>
<% elsif @game.status == "draw" %>
  <h2>🤝 It's a Draw!</h2>
<% end %>

<div class="board">
  <% @game.board.each_with_index do |cell, index| %>
    <%= button_to(
          cell.present? ? cell : " ",
          move_path(index),
          method: :post,
          disabled: cell.present? || @game.status != "playing",
          class: "cell"
        ) %>
  <% end %>
</div>

<br>

<%= button_to "Restart Game", reset_path, method: :post %>
